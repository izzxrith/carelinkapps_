<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Status Header -->
    <TextView
        android:id="@+id/tvWatchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CareLink+ Watch Active"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Big Heart Rate -->
    <ImageView
        android:id="@+id/ivWatchPulse"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_heart"
        app:layout_constraintTop_toBottomOf="@id/tvWatchStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvWatchBpm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="72 BPM"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivWatchPulse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUGE SOS BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWatchSOS"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="HELP"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#F44336"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWatchBpm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp" />

    <!-- Link Button for Teachers to Scan -->
    <ImageView
        android:id="@+id/ivWatchLink"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_qr_code"
        android:padding="8dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF" />

    <!-- Logout for Testing -->
    <TextView
        android:id="@+id/tvWatchLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="#757575"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>